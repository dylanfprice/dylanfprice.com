#!/usr/bin/env bb
; vi: ft=clojure

#_{:clj-kondo/ignore [:namespace-name-mismatch]}
(ns dev
  (:require
   [dylanfprice.clj-cli.core :refer [subcmd-main]]
   [dylanfprice.com.core :as core]))

(def subcmd-table
  [{:cmds ["terraform"]
    :desc "Use terraform to provision dns etc."
    :add-help false
    :fn (fn [_parse-args] (core/terraform (rest *command-line-args*)))}
   {:cmds ["build"]
    :desc "Build site."
    :fn (fn [_parse-args] (core/build))}
   {:cmds ["test"]
    :desc "Run tests."
    :fn (fn [_parse-args] (core/run-tests (rest *command-line-args*)))}
   {:cmds ["serve"]
    :desc "Start dev server."
    :fn (fn [{:keys [opts]}] (core/serve opts))
    :spec {:port {:desc "Port number."
                  :alias :p
                  :coerce :int
                  :default 8000}}}
   {:cmds ["publish"]
    :desc "Publish site."
    :fn (fn [_parse-args] (core/publish))}])

(defn -main [args]
  (subcmd-main "dev" subcmd-table args))

(-main *command-line-args*)
