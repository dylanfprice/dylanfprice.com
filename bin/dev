#!/usr/bin/env bb
; vi: ft=clojure

(ns dev
  (:require [babashka.cli :as cli]
            [clojure.string :as string]
            [dylanfprice.com.core :as core]))

(comment
  (require '[clojure.repl :as repl])
  (repl/dir string/join)
  (repl/doc string/join))

(def help-spec
  {:help {:alias :h
          :coerce :boolean}})

(def serve-spec
  (merge
   help-spec
   {:port {:desc "Port number."
           :alias :p
           :coerce :int
           :default 8000}}))

(def serve-help
  (->> ["Usage:"
        "  dev serve [option]"
        ""
        "Options:"
        (cli/format-opts {:spec serve-spec})]
       (string/join "\n")))

(declare help)

(def command-table
  [{:cmds ["terraform"]
    :desc "Use terraform."
    :fn (fn [_parse-args] (core/terraform (rest *command-line-args*)))}
   {:cmds ["serve"]
    :desc "Start dev server."
    :fn (fn [{:keys [opts]}]
          (if (:help opts) (println serve-help) (core/serve opts)))
    :spec serve-spec}
   {:cmds []
    :fn (fn [parse-args] (println (help parse-args)))
    :spec help-spec}])

(defn help [{:keys [opts]}]
  (let [cmd-help (eduction
                  (map (juxt (comp first :cmds) :desc))
                  (filter first)
                  (map #(apply format "  %-15s %s" %))
                  command-table)]
    (->> (concat
          ["Usage:"
           (str "  dev [option] [command] ...")
           ""
           "Options:"
           (cli/format-opts {:spec help-spec})
           ""
           "Commands:"]
          cmd-help)
         (string/join "\n"))))

(defn error [{:keys [spec type cause msg option] :as data}]
  (if (= :org.babashka/cli type)
    (case cause
      :require
      (println
       (format "Missing required argument:\n%s"
               (cli/format-opts {:spec (select-keys spec [option])})))
      (println msg))
    (throw (ex-info msg data)))
  (System/exit 1))

(defn -main [args]
  (cli/dispatch command-table args {:error-fn error}))

(-main *command-line-args*)
